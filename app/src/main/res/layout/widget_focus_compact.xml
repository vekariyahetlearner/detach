<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/focus_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_focus_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp">

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/widget_focus_action"
        android:importantForAccessibility="no"
        android:padding="5dp"
        android:src="@drawable/ic_sessions"
        android:tint="@color/on_accent" />

    <TextView
        android:id="@+id/focus_widget_label"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginTop="3dp"
        android:autoSizeMaxTextSize="12sp"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/focus_widget_title"
        android:textColor="@color/ink" />
</LinearLayout>
